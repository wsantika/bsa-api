# ==========================================
# BSA API - Environment Configuration
# Salin file ini menjadi '.env' lalu sesuaikan nilainya
# ==========================================

# Konfigurasi Database MySQL (Laragon / XAMPP / Native)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=bsa_db
DB_USERNAME=root
DB_PASSWORD=

# Alternatif: Full Connection String (opsional jika ingin format langsung)
# DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=bsa_db;User=root;Password=;

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development
